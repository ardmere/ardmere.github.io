# Project config (non-secrets). Copy to .env in repo root.
# Operator API keys: prefer ~/.zshenv (see docs/ledger-rpc-runbook.md).
# Dev signer: export PRIVATE_KEY and ANCHOR_SIGNER in ~/.zshenv (testnet only).

# Ethereum Sepolia (primary anchor chain for por CLI)
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
CHAIN_ID=11155111
ANCHOR_CONTRACT=
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Contract verification (optional; keys in ~/.zshenv)
ETHERSCAN_API_KEY=

# On-chain verify — set in ~/.zshenv or uncomment here for local runs:
# INFURA_KEY=
# ALCHEMY_KEY=
# BLOCKCHAIR_API_KEY=
# HELIUS_API_KEY=
# NEAR_RPC=
# CHROMIA_NODE=
